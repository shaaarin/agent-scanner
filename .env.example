# Скопируйте в .env. Платформа не использует моки LLM: любой вызов идёт в
# реальный провайдер.

# --- Модель-судья DeepTeam ---------------------------------------------------
# Эти значения сервисы напрямую не читают: они нужны, чтобы через UI
# зарегистрировать LLMModel (раздел «LLM-модели»).
#
# Подойдёт любой OpenAI-совместимый endpoint: api.openai.com, OpenRouter,
# self-hosted vLLM/Ollama/LM Studio и т.п. Выбирайте недорогой — сканирование
# делает несколько коротких вызовов на каждый тест-кейс.
#
# base_url — корень API (примеры ниже):
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://host.docker.internal:11434/v1   (Ollama)
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=sk-...
LLM_PROVIDER_MODEL=gpt-4o-mini

# --- Анализ кода (promptfoo code-scans) --------------------------------------
# Эти значения docker compose передаёт сервису scanner-promptfoo.
# Анализ выполняет облако Promptfoo: код проверяемого агента уходит к ним.
# Ключ — в аккаунте Promptfoo (https://www.promptfoo.app). Без ключа скан
# «Анализ кода» завершится ошибкой на фазе «Инициализация».
PROMPTFOO_API_KEY=
# Свой сервер Promptfoo (Enterprise On-Prem). Пусто — облако Promptfoo.
PROMPTFOO_CODE_SCAN_API_HOST=

# Optional cloud MCP scanner; passed only to scanner-mcp-snyk
SNYK_TOKEN=

# --- Авторизация платформы (логин + пароль) -----------------------------------
# Пустой SESSION_SECRET_KEY = авторизация выключена: все эндпоинты открыты,
# интерфейс работает без входа (удобно для локальной разработки). Со
# сгенерированным ключом включается вход: POST /auth/login|register,
# сессионная cookie, ролевая модель организаций.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
# Явные origin'ы браузера (cookie требует allow_credentials=True, поэтому
# «*» не работает). Dev-вход: дашборд на 4173 и vite-сервер на 5173.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
# Системный администратор создаётся при старте, если его ещё нет: видит и
# делает всё во всех организациях, приглашает участников.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Секрет машинного контура: одно значение у control-api и всех сервисов,
# которые в него ходят (сканеры, launcher, mitm-прокси) -- заголовок
# X-Internal-Token. Обязателен, когда авторизация включена.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
