# Copy to .env. docker-compose.yml reads this automatically for variable
# substitution (${LLM_PROVIDER_BASE_URL} etc.) and to seed a real LLMModel
# for the demo campaign -- there are no mock LLM stand-ins anymore, so a
# real (or self-hosted) OpenAI-compatible endpoint is required to run the
# local verification stack or the example agents.
#
# Any OpenAI-compatible endpoint works: api.openai.com, OpenRouter, a
# self-hosted vLLM/Ollama/LM Studio server, etc. -- pick something cheap,
# the demo agents only send a handful of short requests each.

# base_url is the bare API root (no trailing /v1) -- examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://host.docker.internal:11434/v1   (Ollama)
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=sk-...
LLM_PROVIDER_MODEL=gpt-4o-mini

CONTROL_API_URL=http://localhost:8000
DEMO_SESSION_ID=demo-session-1
SEED_DEMO_DATA=true
