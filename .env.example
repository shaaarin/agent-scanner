# Скопируйте в .env. Платформа не использует моки LLM: любой вызов идёт в
# реальный OpenAI-совместимый провайдер. Значения ниже нужны, чтобы через UI
# зарегистрировать LLMModel (модель-судья DeepTeam, раздел «LLM-модели») —
# сам .env сервисами напрямую не читается.
#
# Подойдёт любой OpenAI-совместимый endpoint: api.openai.com, OpenRouter,
# self-hosted vLLM/Ollama/LM Studio и т.п. Выбирайте недорогой — сканирование
# делает несколько коротких вызовов на каждый тест-кейс.

# base_url — корень API (примеры ниже):
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://host.docker.internal:11434/v1   (Ollama)
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_API_KEY=sk-...
LLM_PROVIDER_MODEL=gpt-4o-mini
